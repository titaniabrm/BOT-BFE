{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/bot",
    "rootDir": "./src/bot",
    "module": "CommonJS",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["src/bot/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}